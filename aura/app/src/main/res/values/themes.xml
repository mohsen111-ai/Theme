<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aura" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/aura_bg</item>
        <item name="colorAccent">@color/aura_mint</item>
        <item name="colorPrimary">@color/aura_bg</item>
        <item name="android:statusBarColor">@color/aura_bg</item>
        <item name="android:navigationBarColor">@color/aura_panel</item>
        <item name="android:textColorPrimary">#E8F0F7</item>
        <item name="android:alertDialogTheme">@style/Theme.Aura.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.Aura.Dialog</item>
    </style>
    <style name="Theme.Aura.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/aura_panel</item>
        <item name="android:textColorPrimary">#E8F0F7</item>
        <item name="colorAccent">@color/aura_mint</item>
    </style>
</resources>
